{
  "version": 1,
  "browserMode": "managed",
  "destinationName": "m1-local-target",
  "targetUrl": "https://example.invalid/",
  "expectedUrlPrefix": "https://example.invalid/",
  "profileDir": ".actuador/playwright-profile",
  "logDir": ".actuador/logs",
  "prompt": "M1_PLAYWRIGHT_PROMPT_DELIVERY_TEST",
  "timeoutMs": 15000,
  "postSendTimeoutMs": 5000,
  "selectors": {
    "sessionMarker": {
      "strategy": "css",
      "value": "[data-actuator-session='authenticated']"
    },
    "destinationMarker": {
      "strategy": "css",
      "value": "[data-actuator-destination='m1-local-target']"
    },
    "promptInput": {
      "strategy": "css",
      "value": "[data-actuator-prompt-input]"
    },
    "sendButton": {
      "strategy": "css",
      "value": "[data-actuator-send]"
    }
  }
}
